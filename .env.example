# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0

# ─────────────────────────────────────────────
# PostgreSQL (Dev)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ryan_db
DB_USER=ryan
DB_PASSWORD=ryan@1904

# Prisma uses this URL directly
DATABASE_URL="postgresql://ryan:ryan%401904@localhost:5432/ryan_db"

# ─────────────────────────────────────────────
# pgvector
# ─────────────────────────────────────────────
# No extra config needed — pgvector is a PostgreSQL extension.
# Ensure it is installed: CREATE EXTENSION IF NOT EXISTS vector;

# ─────────────────────────────────────────────
# Embedding Model
# ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ─────────────────────────────────────────────
# HuggingFace Hub
# ─────────────────────────────────────────────
# Set to 1 after first run to use local model cache (faster startup).
# Set to 0 or remove to allow model updates from HF Hub.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ─────────────────────────────────────────────
# pg_notify channel (embedding worker)
# ─────────────────────────────────────────────
EMBEDDING_NOTIFY_CHANNEL=product_embedding_channel

# ─────────────────────────────────────────────
# CORS (comma-separated origins, * = allow all)
# ─────────────────────────────────────────────
CORS_ORIGINS=*
